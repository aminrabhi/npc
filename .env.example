# Sunnyside Village - server-side configuration.
#
# Copy this file to .env for local work, and set the same names in
# Vercel -> Project -> Settings -> Environment Variables for the deployment.
# Never commit the real .env: it is ignored by .gitignore.
#
# .env is also read by `npm run dev` (tools/api_server.js).
# Do not put these in a .dev.vars file - Wrangler stops reading .env if one exists.

# --- Groq Cloud -------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# The conversation model. allam-2-7b is the default and is set here on purpose:
# change this one value to move the whole village to another model.
GROQ_MODEL=allam-2-7b

# Optional. Only needed to point the server at a compatible proxy or a test double.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Supabase ---------------------------------------------------------------
# https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- BBC News ---------------------------------------------------------------
# Optional comma-separated override. Defaults to the BBC's own top, technology,
# science and world feeds.
# BBC_FEEDS=https://feeds.bbci.co.uk/news/rss.xml
# NEWS_TTL_MS=900000
